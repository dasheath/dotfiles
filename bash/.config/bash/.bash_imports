# Source other bash configuration files
# This is a simple way to do this bc bash_aliases is sourced by the ubuntu
# default bashrc

files_to_import=(".bash_functions" ".bash_prompt")

for file_to_import in "${files_to_import[@]}"; do
  file_path="$HOME/.config/bash/$file_to_import"
  if [[ -f "$file_path" ]]; then
    . "$file_path"
  fi
done

# For rust lang
if command -v cargo; then
  . "$HOME/.cargo/env" 
fi

# Setup for starship
# if command -v starship ; then
#  eval "$(starship init bash)"
#fi

# Setup for direnv
if command -v direnv ; then
 eval "$(direnv hook bash)"
fi

