# Source other bash configuration files
# This is a simple way to do this bc bash_aliases is sourced by the ubuntu
# default bashrc

if [[ -f ~/.bash_functions ]]; then
  . ~/.bash_functions
fi

if [[ -f ~/.bash_prompt ]]; then
