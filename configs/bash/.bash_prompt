# Git prompt config for bash
#
# This should be sourced to take effect

is_git_available() {
  command -v git &> /dev/null
}

in_git_repo() {
  if ! is_git_available; then
    return 1
  fi

  git rev-parse --is-inside-work-tree &> /dev/null
}

_set_git_prompt() {
  local branch=""

  if is_git_available && in_git_repo ; then
    branch=$(git symbolic-ref --short HEAD 2>/dev/null)
    if [[ -z "$branch" ]]; then
      branch="detached@branch"
    fi

    if [[ -n "$branch" ]]; then
      local status_suffix=""
      if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null ; then
        status_suffix="*"
      fi

      # Format branch with cyan & wrap in parens
      branch=" (\[\033[01;36m\]${branch}${status_suffix}\[\033[00m\])"
    fi
  fi

  # Formulate window/tab title prefix based on custom setting or default
  # This variable gets set by title bash function
  local title_prefix=""
  if [[ -n "$CUSTOM_TAB_TITLE" ]]; then
    title_prefix="$CUSTOM_TAB_TITLE"
  else
    title_prefix="$\u@\h: \w"
  fi

  # Standard terminal prompt: user@host:pwd (git-branch)$
  PS1="\[\e]0;${title_prefix}\a\]\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]${branch}\$ "
}

# Safe integration with existing prompt
if [[ -n "$PROMPT_COMMAND" ]]; then
  if [[ "$PROMPT_COMMAND" != *"_set_git_prompt"* ]]; then
    PROMPT_COMMAND="${PROMPT_COMMAND%;}; _set_git_prompt"
  fi
else
  PROMPT_COMMAND="_set_git_prompt"
fi

